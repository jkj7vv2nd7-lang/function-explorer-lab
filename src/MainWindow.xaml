<Window x:Class="FunctionExplorer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
 Title="関数探究ラボ" Icon="Assets/function-explorer.ico" Height="1000" Width="1600" MinHeight="680" MinWidth="980"
 WindowStartupLocation="CenterScreen" Background="#F4F2ED" FontFamily="Yu Gothic UI" PreviewKeyDown="MainWindow_PreviewKeyDown">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#24363B"/><SolidColorBrush x:Key="Muted" Color="#718184"/><SolidColorBrush x:Key="Teal" Color="#237A70"/><SolidColorBrush x:Key="Card" Color="#FFFEFB"/><SolidColorBrush x:Key="Line" Color="#E3E7E1"/>
  <Style TargetType="Button"><Setter Property="Background" Value="#EAF3EF"/><Setter Property="Foreground" Value="#245C54"/><Setter Property="BorderBrush" Value="#D6E7E0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="0,0,7,6"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="chrome" Property="Background" Value="#DCECE5"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="chrome" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="chrome" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#FFFDF8"/><Setter Property="BorderBrush" Value="#DDE4DE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="7"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#FFFDF8"/><Setter Property="BorderBrush" Value="#DDE4DE"/><Setter Property="Padding" Value="6"/></Style>
 </Window.Resources>
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel x:Name="MainTitleBar" Grid.Row="0" Margin="6,0,6,8">
   <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="関数探究ラボ" FontSize="25" FontWeight="Bold" Foreground="#24363B"/><TextBlock Text="　予想して、試して、説明しよう" Foreground="#718184" VerticalAlignment="Center" Margin="5,5,0,0"/><TextBlock x:Name="LessonProgressDisplay" Text="　1/3 問い・予想" Foreground="#237A70" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,5,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="StudentModeBox" Content="生徒・提示モード" VerticalAlignment="Center" Margin="5,0,10,0" Checked="StudentMode_Changed" Unchecked="StudentMode_Changed"/><Button x:Name="LessonStep1Button" Content="① 問い" Tag="0" Click="LessonStep_Click"/><Button x:Name="LessonStep2Button" Content="② 操作" Tag="1" Click="LessonStep_Click"/><Button x:Name="LessonStep3Button" Content="③ 説明" Tag="2" Click="LessonStep_Click"/><Button x:Name="PresentationButton" Content="提示全画面" Click="PresentationMode_Click"/><Button Content="学年・単元対応表" Click="CurriculumMap_Click"/><Button x:Name="ToolsToggleButton" Content="設定を隠す" Click="ToggleToolsPane_Click"/><Border Background="#E2F0E9" CornerRadius="16" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="Windows 11・オフライン対応" Foreground="#237A70" FontWeight="SemiBold"/></Border></StackPanel>
  </DockPanel>
  <Border x:Name="RibbonBar" Grid.Row="1" Background="#E9EEE9" BorderBrush="#DDE4DE" BorderThickness="1" CornerRadius="14" Padding="12,9" Margin="0,0,0,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="場面から探究" FontWeight="Bold" FontSize="11" Foreground="#718184"/><DockPanel><ComboBox x:Name="ScenarioBox" Margin="0,4,0,0" Height="34" SelectionChanged="ScenarioBox_SelectionChanged"/><Button Content="場面JSON読込" Click="ImportScenario_Click" Margin="6,4,0,0" Padding="8,5"/></DockPanel><TextBlock x:Name="ScenarioDescription" Foreground="#718184" TextTrimming="CharacterEllipsis" Margin="2,3,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="学年・科目" FontWeight="Bold" FontSize="11" Foreground="#718184"/><ComboBox x:Name="GradeBox" Margin="0,4,0,0" Height="34" SelectionChanged="GradeBox_SelectionChanged"/></StackPanel>
    <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="関数・単元" FontWeight="Bold" FontSize="11" Foreground="#718184"/><ComboBox x:Name="FunctionList" Margin="0,4,0,0" Height="34" SelectionChanged="FunctionList_SelectionChanged"/></StackPanel>
    <StackPanel Grid.Column="3" Margin="0,0,12,0"><TextBlock Text="表示中の式" FontWeight="Bold" FontSize="11" Foreground="#718184"/><TextBlock x:Name="Formula" Text="y = ax" FontFamily="Cambria Math" FontSize="17" Foreground="#39455B" Margin="0,5,0,0"/><TextBlock x:Name="GradeTag" Foreground="#3559D8" FontWeight="SemiBold" FontSize="11"/></StackPanel>
    <TextBlock Grid.Column="4" Text="関数探究\nリボン" Foreground="#237A70" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" Margin="8,0,4,0"/>
   </Grid>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ToolsColumn" Width="320"/></Grid.ColumnDefinitions>
   <Grid Grid.Column="0" Margin="0,0,12,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="10,6" Margin="0,0,0,8">
     <DockPanel><TextBlock x:Name="TopicTitle" Text="比例" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="3,0,12,0"/><TextBlock Text="同じ関数の係数を比較" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.7*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="2,0,5,0"><DockPanel><CheckBox x:Name="ParamCompareAEnabled" Content="セット1" VerticalAlignment="Center" Checked="ParamComparison_Changed" Unchecked="ParamComparison_Changed"/><TextBox x:Name="ParamCompareAName" Text="比較 A" TextChanged="ParamComparison_Changed"/></DockPanel><DockPanel><TextBox x:Name="ParamCompareAValues" Text="2, 2, 0" ToolTip="a, b, c/k" TextChanged="ParamComparison_Changed"/><ComboBox x:Name="ParamCompareAColor" Width="74" Margin="3,0,0,0" SelectionChanged="ParamComparison_Changed"/></DockPanel></StackPanel>
      <StackPanel Grid.Column="1" Margin="2,0,5,0"><DockPanel><CheckBox x:Name="ParamCompareBEnabled" Content="セット2" VerticalAlignment="Center" Checked="ParamComparison_Changed" Unchecked="ParamComparison_Changed"/><TextBox x:Name="ParamCompareBName" Text="比較 B" TextChanged="ParamComparison_Changed"/></DockPanel><DockPanel><TextBox x:Name="ParamCompareBValues" Text="-1, 2, 0" ToolTip="a, b, c/k" TextChanged="ParamComparison_Changed"/><ComboBox x:Name="ParamCompareBColor" Width="74" Margin="3,0,0,0" SelectionChanged="ParamComparison_Changed"/></DockPanel></StackPanel>
      <StackPanel Grid.Column="2" Margin="2,0,5,0"><DockPanel><CheckBox x:Name="ParamCompareCEnabled" Content="セット3" VerticalAlignment="Center" Checked="ParamComparison_Changed" Unchecked="ParamComparison_Changed"/><TextBox x:Name="ParamCompareCName" Text="比較 C" TextChanged="ParamComparison_Changed"/></DockPanel><DockPanel><TextBox x:Name="ParamCompareCValues" Text="1, -1, 1" ToolTip="a, b, c/k" TextChanged="ParamComparison_Changed"/><ComboBox x:Name="ParamCompareCColor" Width="74" Margin="3,0,0,0" SelectionChanged="ParamComparison_Changed"/></DockPanel></StackPanel>
