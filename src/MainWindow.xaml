<Window x:Class="FunctionExplorer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
 Title="関数探究ラボ" Height="1000" Width="1600" MinHeight="680" MinWidth="980"
 WindowStartupLocation="CenterScreen" Background="#F4F2ED" FontFamily="Yu Gothic UI" PreviewKeyDown="MainWindow_PreviewKeyDown">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#24363B"/><SolidColorBrush x:Key="Muted" Color="#718184"/><SolidColorBrush x:Key="Teal" Color="#237A70"/><SolidColorBrush x:Key="Card" Color="#FFFEFB"/><SolidColorBrush x:Key="Line" Color="#E3E7E1"/>
  <Style TargetType="Button"><Setter Property="Background" Value="#EAF3EF"/><Setter Property="Foreground" Value="#245C54"/><Setter Property="BorderBrush" Value="#D6E7E0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="0,0,7,6"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="chrome" Property="Background" Value="#DCECE5"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="chrome" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="chrome" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#FFFDF8"/><Setter Property="BorderBrush" Value="#DDE4DE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="7"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#FFFDF8"/><Setter Property="BorderBrush" Value="#DDE4DE"/><Setter Property="Padding" Value="6"/></Style>
 </Window.Resources>
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel x:Name="MainTitleBar" Grid.Row="0" Margin="6,0,6,8">
   <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="関数探究ラボ" FontSize="25" FontWeight="Bold" Foreground="#24363B"/><TextBlock Text="　予想して、試して、説明しよう" Foreground="#718184" VerticalAlignment="Center" Margin="5,5,0,0"/><TextBlock x:Name="LessonProgressDisplay" Text="　1/3 問い・予想" Foreground="#237A70" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,5,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="StudentModeBox" Content="生徒・提示モード" VerticalAlignment="Center" Margin="5,0,10,0" Checked="StudentMode_Changed" Unchecked="StudentMode_Changed"/><Button x:Name="LessonStep1Button" Content="① 問い" Tag="0" Click="LessonStep_Click"/><Button x:Name="LessonStep2Button" Content="② 操作" Tag="1" Click="LessonStep_Click"/><Button x:Name="LessonStep3Button" Content="③ 説明" Tag="2" Click="LessonStep_Click"/><Button x:Name="PresentationButton" Content="提示全画面" Click="PresentationMode_Click"/><Button Content="学年・単元対応表" Click="CurriculumMap_Click"/><Button x:Name="ToolsToggleButton" Content="設定を隠す" Click="ToggleToolsPane_Click"/><Border Background="#E2F0E9" CornerRadius="16" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="Windows 11・オフライン対応" Foreground="#237A70" FontWeight="SemiBold"/></Border></StackPanel>
  </DockPanel>
  <Border x:Name="RibbonBar" Grid.Row="1" Background="#E9EEE9" BorderBrush="#DDE4DE" BorderThickness="1" CornerRadius="14" Padding="12,9" Margin="0,0,0,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="場面から探究" FontWeight="Bold" FontSize="11" Foreground="#718184"/><DockPanel><ComboBox x:Name="ScenarioBox" Margin="0,4,0,0" Height="34" SelectionChanged="ScenarioBox_SelectionChanged"/><Button Content="場面JSON読込" Click="ImportScenario_Click" Margin="6,4,0,0" Padding="8,5"/></DockPanel><TextBlock x:Name="ScenarioDescription" Foreground="#718184" TextTrimming="CharacterEllipsis" Margin="2,3,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="学年・科目" FontWeight="Bold" FontSize="11" Foreground="#718184"/><ComboBox x:Name="GradeBox" Margin="0,4,0,0" Height="34" SelectionChanged="GradeBox_SelectionChanged"/></StackPanel>
    <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="関数・単元" FontWeight="Bold" FontSize="11" Foreground="#718184"/><ComboBox x:Name="FunctionList" Margin="0,4,0,0" Height="34" SelectionChanged="FunctionList_SelectionChanged"/></StackPanel>
    <StackPanel Grid.Column="3" Margin="0,0,12,0"><TextBlock Text="表示中の式" FontWeight="Bold" FontSize="11" Foreground="#718184"/><TextBlock x:Name="Formula" Text="y = ax" FontFamily="Cambria Math" FontSize="17" Foreground="#39455B" Margin="0,5,0,0"/><TextBlock x:Name="GradeTag" Foreground="#3559D8" FontWeight="SemiBold" FontSize="11"/></StackPanel>
    <TextBlock Grid.Column="4" Text="関数探究\nリボン" Foreground="#237A70" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" Margin="8,0,4,0"/>
   </Grid>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ToolsColumn" Width="320"/></Grid.ColumnDefinitions>
   <Grid Grid.Column="0" Margin="0,0,12,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="10,6" Margin="0,0,0,8">
     <DockPanel><TextBlock x:Name="TopicTitle" Text="比例" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="3,0,12,0"/><TextBlock Text="同じ関数の係数を比較" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.7*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="2,0,5,0"><DockPanel><CheckBox x:Name="ParamCompareAEnabled" Content="セット1" VerticalAlignment="Center" Checked="ParamComparison_Changed" Unchecked="ParamComparison_Changed"/><TextBox x:Name="ParamCompareAName" Text="比較 A" TextChanged="ParamComparison_Changed"/></DockPanel><DockPanel><TextBox x:Name="ParamCompareAValues" Text="2, 2, 0" ToolTip="a, b, c/k" TextChanged="ParamComparison_Changed"/><ComboBox x:Name="ParamCompareAColor" Width="74" Margin="3,0,0,0" SelectionChanged="ParamComparison_Changed"/></DockPanel></StackPanel>
      <StackPanel Grid.Column="1" Margin="2,0,5,0"><DockPanel><CheckBox x:Name="ParamCompareBEnabled" Content="セット2" VerticalAlignment="Center" Checked="ParamComparison_Changed" Unchecked="ParamComparison_Changed"/><TextBox x:Name="ParamCompareBName" Text="比較 B" TextChanged="ParamComparison_Changed"/></DockPanel><DockPanel><TextBox x:Name="ParamCompareBValues" Text="-1, 2, 0" ToolTip="a, b, c/k" TextChanged="ParamComparison_Changed"/><ComboBox x:Name="ParamCompareBColor" Width="74" Margin="3,0,0,0" SelectionChanged="ParamComparison_Changed"/></DockPanel></StackPanel>
      <StackPanel Grid.Column="2" Margin="2,0,5,0"><DockPanel><CheckBox x:Name="ParamCompareCEnabled" Content="セット3" VerticalAlignment="Center" Checked="ParamComparison_Changed" Unchecked="ParamComparison_Changed"/><TextBox x:Name="ParamCompareCName" Text="比較 C" TextChanged="ParamComparison_Changed"/></DockPanel><DockPanel><TextBox x:Name="ParamCompareCValues" Text="1, -1, 1" ToolTip="a, b, c/k" TextChanged="ParamComparison_Changed"/><ComboBox x:Name="ParamCompareCColor" Width="74" Margin="3,0,0,0" SelectionChanged="ParamComparison_Changed"/></DockPanel></StackPanel>
      <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="関数を重ねて比較（最大3つ）" Foreground="#69758C" FontSize="10"/><ListBox x:Name="ComparisonList" Height="48" SelectionMode="Multiple" SelectionChanged="Compare_SelectionChanged"/></StackPanel>
     </Grid><TextBlock x:Name="ComparisonValidation" DockPanel.Dock="Right" Foreground="#A84432" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0"/>
     </DockPanel>
    </Border>
    <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="2" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DockTableColumn" Width="0"/></Grid.ColumnDefinitions><Canvas x:Name="Plot" Grid.Column="0" Background="#FFFEFB" ClipToBounds="True" Focusable="True" SizeChanged="Plot_SizeChanged" MouseMove="Plot_MouseMove" MouseWheel="Plot_MouseWheel" MouseLeftButtonDown="Plot_MouseLeftButtonDown" MouseLeftButtonUp="Plot_MouseLeftButtonUp" MouseLeave="Plot_MouseLeave"/><TextBlock x:Name="PlotCoordinates" Grid.Column="0" Text="グラフ上をクリックして座標を確認　・　Shift+クリックで2点間を比較　・　ホイールで拡大　・　ドラッグで移動" Foreground="#718184" Background="#FFFEFB" Opacity="0.9" FontSize="12" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10" IsHitTestVisible="False"/><StackPanel x:Name="GraphToolsBar" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"><ComboBox x:Name="GraphPresetBox" Width="120" Height="31" Margin="0,0,6,0" SelectionChanged="GraphPreset_SelectionChanged"/><Button Content="x-y 対応表" x:Name="TableToggleButton" Click="ToggleValueTable_Click"/><Button Content="横並び表示" x:Name="TableDockToggleButton" Click="ToggleTableDock_Click"/><Button Content="PNG保存" Click="ExportPlot_Click"/><Button Content="表示をリセット" Click="ResetPlotView_Click"/></StackPanel><StackPanel x:Name="ProbeInputPanel" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8,0,0" Background="#F8FFFE"><TextBlock Text="xA" VerticalAlignment="Center" Margin="4,0"/><TextBox x:Name="ProbeAXBox" Width="64" Text="0" VerticalContentAlignment="Center"/><TextBlock Text="xB" VerticalAlignment="Center" Margin="8,0,4,0"/><TextBox x:Name="ProbeBXBox" Width="64" Text="1" VerticalContentAlignment="Center"/><Button Content="点を指定" Click="ApplyProbeX_Click" Margin="6,0,0,0" Padding="8,5"/><TextBlock x:Name="ProbeResultText" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#237A70" FontWeight="SemiBold"/></StackPanel><Border x:Name="TableDockPanel" Grid.Column="1" Visibility="Collapsed" Background="#FFFFFF" BorderBrush="#DDE4DE" BorderThickness="1" CornerRadius="10" Margin="4"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="8,6"><TextBlock Text="x-y 対応表" FontWeight="Bold" VerticalAlignment="Center"/><Button Content="CSV保存" Click="ExportTableCsv_Click" Margin="10,0,0,0" Padding="8,4"/></DockPanel><DataGrid x:Name="ValueTable" AutoGenerateColumns="True" IsReadOnly="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AutoGeneratingColumn="ValueTable_AutoGeneratingColumn" CellEditEnding="ValueTable_CellEditEnding"/></DockPanel></Border><Border x:Name="PresentationPromptPanel" Grid.Column="0" Visibility="Collapsed" Background="#F2FFFFFF" BorderBrush="#237A70" BorderThickness="2" CornerRadius="14" Padding="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,16,18,0" MaxWidth="720"><StackPanel><TextBlock Text="探究の問い　（Esc で提示を終了）" FontSize="15" FontWeight="Bold" Foreground="#237A70"/><TextBlock x:Name="PresentationQuestionText" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,12"/><TextBlock x:Name="PresentationGoalText" FontSize="16" TextWrapping="Wrap" Foreground="#45565A"/></StackPanel></Border></Grid></Border>
   </Grid>
   <ScrollViewer x:Name="ToolsPane" Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,14"><StackPanel>
     <TextBlock Text="パラメータを動かす" FontSize="17" FontWeight="Bold"/><TextBlock Text="式・グラフ・表の連動を観察" Foreground="#69758C" Margin="0,3,0,14"/>
     <TextBlock x:Name="ParamALabel" Text="a の値"/><DockPanel Margin="0,5,0,12"><Slider x:Name="ParamASlider" Minimum="-5" Maximum="5" Value="1" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Parameter_Changed"/><TextBlock x:Name="ParamAValue" Width="45" Text="1" TextAlignment="Right" VerticalAlignment="Center"/></DockPanel>
     <StackPanel x:Name="ParamBPanel"><TextBlock x:Name="ParamBLabel" Text="b の値"/><DockPanel Margin="0,5,0,12"><Slider x:Name="ParamBSlider" Minimum="-5" Maximum="5" Value="0" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Parameter_Changed"/><TextBlock x:Name="ParamBValue" Width="45" Text="0" TextAlignment="Right" VerticalAlignment="Center"/></DockPanel></StackPanel>
     <StackPanel x:Name="ParamCPanel"><TextBlock x:Name="ParamCLabel" Text="c の値"/><DockPanel Margin="0,5,0,2"><Slider x:Name="ParamCSlider" Minimum="-5" Maximum="5" Value="0" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Parameter_Changed"/><TextBlock x:Name="ParamCValue" Width="45" Text="0" TextAlignment="Right" VerticalAlignment="Center"/></DockPanel></StackPanel>
     <Separator Margin="0,12,0,10"/>
     <TextBlock Text="グラフに表示する x の変域" FontWeight="SemiBold"/>
     <Grid Margin="0,7,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="RangeMinBox" Text="-10" Padding="6" ToolTip="下限。数値または π を入力" TextChanged="Range_ValueChanged"/><TextBlock Grid.Column="1" Text="～" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBox Grid.Column="2" x:Name="RangeMaxBox" Text="10" Padding="6" ToolTip="上限。数値または π を入力" TextChanged="Range_ValueChanged"/></Grid>
     <UniformGrid Columns="2" Margin="0,4,0,2"><CheckBox x:Name="StartIncludedBox" Content="下限を含む（≦）" IsChecked="True" Checked="RangeOption_Changed" Unchecked="RangeOption_Changed"/><CheckBox x:Name="EndIncludedBox" Content="上限を含む（≦）" IsChecked="True" Checked="RangeOption_Changed" Unchecked="RangeOption_Changed"/></UniformGrid>
     <ComboBox x:Name="RangeStyleBox" Margin="0,5,0,2" Height="30" SelectionChanged="RangeStyle_SelectionChanged"/>
     <TextBlock x:Name="RangeDisplay" Foreground="#3559D8" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
     <TextBlock x:Name="RangeError" Foreground="#B42318" FontSize="11" TextWrapping="Wrap"/>
     <TextBlock x:Name="RateDisplay" Foreground="#3559D8" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="グラフから読み取れる特徴" FontWeight="Bold" Foreground="#24363B" Margin="0,10,0,3"/><TextBlock x:Name="GraphFactsDisplay" Foreground="#3559D8" TextWrapping="Wrap"/>
     <TextBlock x:Name="ParamHint" Text="スライダーを動かして変化を観察しよう。" TextWrapping="Wrap" Foreground="#69758C" Margin="0,12,0,0"/>
    </StackPanel></Border>
    <Border x:Name="StudentWorkspacePanel" Visibility="Collapsed" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,12"><StackPanel>
     <TextBlock Text="探究ワークスペース" FontSize="18" FontWeight="Bold" Foreground="#24363B"/><TextBlock Text="問いを読み、予想し、グラフを動かして、根拠を説明します。" Foreground="#718184" Margin="0,3,0,10"/>
     <TabControl x:Name="LessonFlowTabs" SelectionChanged="LessonFlowTabs_SelectionChanged">
      <TabItem Header="1 問い・予想"><StackPanel Margin="10"><TextBlock Text="探究の問い" FontWeight="Bold"/><TextBlock x:Name="StudentQuestionDisplay" TextWrapping="Wrap" Margin="0,5,0,10"/><TextBlock Text="学習のねらい" FontWeight="Bold"/><TextBlock x:Name="StudentGoalDisplay" TextWrapping="Wrap" Margin="0,5,0,10"/><TextBlock Text="自分の予想" FontWeight="Bold"/><TextBox x:Name="StudentPredictionBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel></TabItem>
      <TabItem Header="2 操作・記録"><StackPanel Margin="10"><TextBlock Text="グラフを操作し、点Aはクリック、点BはShift+クリックで選びましょう。" TextWrapping="Wrap"/><TextBlock x:Name="StudentProbeDisplay" Foreground="#237A70" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,10"/><TextBlock Text="式・表・グラフから見つけた根拠" FontWeight="Bold"/><TextBox x:Name="StudentObservationBox" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><Button Content="現在の操作を記録" Click="RecordStudentObservation_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></TabItem>
      <TabItem Header="3 説明・振り返り"><StackPanel Margin="10"><TextBlock Text="自分の説明" FontWeight="Bold"/><TextBox x:Name="StudentExplanationBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,5,0,10"/><TextBlock Text="振り返り" FontWeight="Bold"/><TextBox x:Name="StudentReflectionBox" Height="75" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,5,0,10"/><TextBlock Text="自己評価：できたことにチェック" FontWeight="Bold"/><CheckBox x:Name="RubricFormulaBox" Content="式・係数の意味を説明できた"/><CheckBox x:Name="RubricTableBox" Content="表の変化を根拠にできた"/><CheckBox x:Name="RubricGraphBox" Content="グラフの特徴を根拠にできた"/><CheckBox x:Name="RubricReasonBox" Content="予想と結果を比べて説明できた"/><WrapPanel Margin="0,10,0,0"><Button Content="探究記録を保存" Click="SaveStudentWork_Click"/><Button Content="予想と説明を比べる" Click="ShowReflectionCompare_Click"/></WrapPanel></StackPanel></TabItem>
     </TabControl>
    </StackPanel></Border>
    <Border x:Name="TeacherPanel" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="18"><StackPanel>
     <DockPanel><TextBlock Text="教師用：教材をつくる" FontSize="17" FontWeight="Bold"/><TextBlock Text="授業の問い・活動を編集" Foreground="#3559D8" HorizontalAlignment="Right"/></DockPanel>
     <WrapPanel Margin="0,12,0,2"><Button Content="教材を開く" Click="OpenLesson_Click"/><Button Content="教材を保存" Click="SaveLesson_Click"/><Button Content="複製して保存" Click="DuplicateLesson_Click"/><Button Content="パッケージ出力" Click="ExportLessonPackage_Click"/><Button Content="パッケージ読込" Click="ImportLessonPackage_Click"/><Button Content="生徒記録をまとめて確認" Click="ReviewStudentSubmissions_Click"/><Button Content="元に戻す" Click="Undo_Click"/></WrapPanel><TextBlock x:Name="SaveStatusText" Text="未保存の作業" Foreground="#9A5B18" FontWeight="SemiBold" Margin="2,0,0,4"/>
     <DockPanel><TextBlock Text="教材ひな型" VerticalAlignment="Center" Foreground="#69758C"/><ComboBox x:Name="LessonTemplateBox" Width="190" Margin="6,0"/><Button Content="ひな型を適用" Click="ApplyLessonTemplate_Click"/></DockPanel>
     <TextBlock Text="教材ライブラリ（タイトル・単元・タグで検索）" Foreground="#69758C" Margin="0,5,0,3"/><TextBox x:Name="LessonSearchBox" ToolTip="タイトル、学年、単元、タグを検索" TextChanged="LessonSearch_Changed"/><ComboBox x:Name="RecentFilesBox" Margin="0,4,0,3" SelectionChanged="RecentFiles_SelectionChanged"/><DockPanel><TextBlock Text="教材タグ" VerticalAlignment="Center"/><TextBox x:Name="LessonTagsBox" ToolTip="例：導入、グループ活動、50分"/><CheckBox x:Name="FavoriteLessonBox" Content="★ お気に入り" VerticalAlignment="Center" Margin="6,0,0,0" Click="FavoriteLesson_Click"/></DockPanel>
     <Expander Header="自分の場面教材を作成" Margin="0,8,0,4"><StackPanel>
      <ComboBox x:Name="ScenarioTopicBox" Margin="0,4,0,3"/>
      <TextBox x:Name="ScenarioNameBox" ToolTip="教材名" Margin="0,3"/>
      <TextBox x:Name="ScenarioDescriptionBox" ToolTip="場面と数量・単位を説明" Height="54" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,3"/>
      <TextBox x:Name="ScenarioQuestionBox" ToolTip="探究の問い" Margin="0,3"/>
      <TextBox x:Name="ScenarioGoalBox" ToolTip="学習のねらい" Margin="0,3"/>
      <DockPanel Margin="0,3"><TextBox x:Name="ScenarioMinBox" Text="0" ToolTip="x の下限"/><TextBlock Text="から" VerticalAlignment="Center" Margin="4,0"/><TextBox x:Name="ScenarioMaxBox" Text="10" ToolTip="x の上限"/><TextBox x:Name="ScenarioXUnitBox" ToolTip="x 軸の単位" Margin="4,0,0,0"/><TextBox x:Name="ScenarioYUnitBox" ToolTip="y 軸の単位" Margin="4,0,0,0"/></DockPanel>
      <WrapPanel><Button Content="場面ライブラリに追加" Click="AddCustomScenario_Click"/><Button Content="自作場面を JSON 出力" Click="ExportScenario_Click"/></WrapPanel>
     </StackPanel></Expander>
     <TextBlock Text="探究の問い" Foreground="#69758C" Margin="0,8,0,4"/><TextBox x:Name="QuestionBox" Height="56" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="7"/>
     <TextBlock Text="学習のねらい" Foreground="#69758C" Margin="0,9,0,4"/><TextBox x:Name="GoalBox" Height="52" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="7"/>
     <TextBlock Text="① 予想する問い" Foreground="#69758C" Margin="0,9,0,4"/><TextBox x:Name="PredictionBox" Height="48" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="7"/>
     <TextBlock Text="② 試して記録する問い" Foreground="#69758C" Margin="0,9,0,4"/><TextBox x:Name="EvidenceBox" Height="48" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="7"/>
     <TextBlock Text="③ 説明・まとめの問い" Foreground="#69758C" Margin="0,9,0,4"/><TextBox x:Name="ExplainBox" Height="48" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="7"/>
     <TextBlock Text="授業メモ・条件（教師用）" Foreground="#69758C" Margin="0,9,0,4"/><TextBox x:Name="NotesBox" Height="52" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="7"/>
     <TextBlock Text="授業時間（分）・想定する反応" Foreground="#69758C" Margin="0,9,0,4"/><DockPanel><TextBox x:Name="LessonMinutesBox" Width="64" Text="50" Padding="6"/><TextBlock Text="分" VerticalAlignment="Center" Margin="5,0,10,0"/><TextBox x:Name="StudentResponseBox" Height="48" TextWrapping="Wrap" AcceptsReturn="True" Padding="6"/></DockPanel><WrapPanel Margin="0,4,0,2"><Button Content="授業タイマー開始／一時停止" Click="LessonTimerToggle_Click"/><Button Content="タイマーリセット" Click="LessonTimerReset_Click"/><Button Content="前の段階" Click="PreviousLessonStep_Click"/><Button Content="次の段階" Click="NextLessonStep_Click"/><TextBlock x:Name="LessonClockDisplay" Text="50:00" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#237A70" Margin="5,0"/></WrapPanel>
     <TextBlock Text="つまずきへの支援・評価の観点" Foreground="#69758C" Margin="0,9,0,4"/><TextBox x:Name="SupportBox" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Padding="7"/>
     <TextBlock Text="探究ログ（現在の設定を記録）" Foreground="#69758C" Margin="0,9,0,4"/><TextBox x:Name="ReflectionBox" Height="58" TextWrapping="Wrap" AcceptsReturn="True" Padding="7" ToolTip="予想や操作して気づいたことを記入"/><WrapPanel Margin="0,6,0,0"><Button Content="操作を記録" Click="RecordObservation_Click" Padding="9,6" Margin="0,0,7,5"/><Button Content="記録を保存" Click="SaveJournal_Click" Padding="9,6" Margin="0,0,7,5"/><Button Content="記録を開く" Click="OpenJournal_Click" Padding="9,6" Margin="0,0,0,5"/></WrapPanel>
     <TextBox x:Name="JournalBox" Height="105" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="7"/><TextBlock Text="操作履歴（設定・点の選択）" Foreground="#69758C" Margin="0,8,0,3"/><ListBox x:Name="ActivityTimelineBox" Height="92"/><WrapPanel><Button x:Name="ReplayButton" Content="履歴を再生" Click="ReplayActivity_Click"/><Button Content="履歴を消去" Click="ClearActivity_Click"/></WrapPanel>
     <TextBlock Text="表示・印刷の設定" Foreground="#69758C" Margin="0,9,0,4"/><DockPanel><ComboBox x:Name="AccessibilityBox" Width="145" SelectionChanged="DisplaySettings_Changed"/><ComboBox x:Name="TextScaleBox" Width="105" Margin="6,0,0,0" SelectionChanged="DisplaySettings_Changed"/></DockPanel>
     <WrapPanel Margin="0,12,0,0"><Button Content="生徒用を印刷・PDF" Click="PrintStudent_Click" Background="#237A70" Foreground="White" FontWeight="Bold" Padding="12,9" Margin="0,0,8,5" BorderThickness="0"/><Button Content="教師用を印刷・PDF" Click="PrintTeacher_Click" Padding="12,9" Margin="0,0,8,5"/><Button Content="生徒用テキスト" Click="ExportStudent_Click" Padding="12,9" Margin="0,0,8,5"/><Button Content="教師用テキスト" Click="ExportTeacher_Click" Padding="12,9" Margin="0,0,0,5"/></WrapPanel>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>
  </Grid>
  <primitives:Popup x:Name="ValueTablePopup" PlacementTarget="{Binding ElementName=TableToggleButton}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
   <Border Background="{StaticResource Card}" BorderBrush="#C9D8D2" BorderThickness="1" CornerRadius="12" Padding="12" Width="720" Height="390">
    <DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBlock Text="x・y の対応表　（x 列を編集できます）" FontWeight="Bold" VerticalAlignment="Center"/><Button Content="CSV保存" Click="ExportTableCsv_Click" Margin="14,0,0,5" Padding="9,5"/></StackPanel><DataGrid x:Name="FloatingValueTable" AutoGenerateColumns="True" IsReadOnly="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AutoGeneratingColumn="ValueTable_AutoGeneratingColumn" CellEditEnding="ValueTable_CellEditEnding"/></DockPanel>
   </Border>
  </primitives:Popup>
 </Grid>
</Window>
